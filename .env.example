# Example environment for a PostgreSQL deployment. Never commit real credentials.
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/truthlens_db
SPRING_DATASOURCE_USERNAME=truthlens_user
SPRING_DATASOURCE_PASSWORD=your_secure_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
H2_CONSOLE_ENABLED=false
JWT_SECRET=replace_with_a_unique_base64_encoded_secret_of_at_least_32_bytes
